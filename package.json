{
  "name": "portfolio-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio platform monorepo root (pnpm workspace: lab app + shared JS packages). Python services live in the sibling uv workspace.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @portfolio/lab dev",
    "build:web": "pnpm --filter @portfolio/lab build",
    "preview:web": "pnpm --filter @portfolio/lab preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
