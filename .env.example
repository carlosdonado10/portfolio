# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- Supabase (managed, OFF-BOX) — auth + state store ---
# The control-plane and agent reach Supabase for auth/state. Supabase is NOT a
# compose service; it runs off-box. Only these connection values are wired here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Platform ports (host side) ---
LANDING_PORT=8080
CONTROL_PLANE_PORT=8000

# --- Agent: host Docker socket path (ONLY the agent mounts this) ---
DOCKER_SOCK=/var/run/docker.sock
