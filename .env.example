# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# Plain KEY=value lines only (no quotes, no spaces): the Makefile includes this file.

# --- Required secrets (>= 16 characters each) ---
# Signs the anonymous visitor cookie and the admin cookie.
ORCH_COOKIE_SECRET=change-me-to-a-32-char-random-string
# Unlocks /lab/admin. Rotating it revokes every admin session.
ORCH_OWNER_SECRET=change-me-to-another-32-char-string

# --- Host port ---
# The only published port: the nginx gateway (container :80).
HTTP_PORT=8080

# --- Paths (ABSOLUTE; mounted into the agent at the same path) ---
# Leave unset for local dev (the Makefile defaults to $(CURDIR)/projects and
# $(CURDIR)/.dev/repos). On the server set absolute paths, for example:
# ORCH_PROJECTS_DIR=/srv/orch/projects
# ORCH_REPOS_DIR=/srv/orch/repos

# --- Behaviour ---
# 1 = also serve _-prefixed example projects (projects/_examples). 0 in production.
ORCH_INCLUDE_HIDDEN=0
# true behind HTTPS; false for local plain http (otherwise browsers drop the cookie).
ORCH_COOKIE_SECURE=true
# Public origin, used for links in emails, e.g. https://lab.example.com
ORCH_PUBLIC_BASE_URL=

# --- Optional: email ("your turn" notices). Both must be set to enable it. ---
ORCH_RESEND_API_KEY=
ORCH_EMAIL_FROM=

# --- Optional: SSE keepalive ping interval in seconds (also refreshes queue presence) ---
# ORCH_SSE_PING_S=15

# --- Optional: lease timing in seconds (defaults shown) ---
# ORCH_LEASE__WINDOW_S=900
# ORCH_LEASE__GRACE_S=180
# ORCH_LEASE__IDLE_S=180
# ORCH_LEASE__PRESENCE_S=120

# --- Agent: host Docker socket path (ONLY the agent mounts this) ---
DOCKER_SOCK=/var/run/docker.sock
